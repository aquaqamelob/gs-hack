# Copy to .env.local for `bun run dev`. docker compose sets these itself.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ctrl
SMS_GATEWAY_URL=http://localhost:4010
SMTP_URL=smtp://localhost:1025
PUBLIC_URL=http://localhost:3000

# Optional Redpanda/Kafka consumer; without it, ingest is HTTP only.
# KAFKA_BROKERS=localhost:19092
# KAFKA_TOPICS=events,logs

# Runbook webhooks: targets must be in the allowlist; secrets only from env.
WORKFLOW_API=http://localhost:4010/workflow-api
ESCALATION_API=http://localhost:4010/escalation-api
ACTION_ALLOWED_HOSTS=localhost,127.0.0.1,counterparty-service
# WORKFLOW_API_TOKEN=

# Ingest auth per source (INGEST_TOKEN_<SOURCE> / INGEST_HMAC_<SOURCE>) or global (INGEST_TOKEN / INGEST_HMAC_SECRET).
INGEST_TOKEN_PARTNER=dev-partner-token
INGEST_HMAC_PAYMENTS=dev-payments-hmac
# SMS/email reply webhook. Set the same REPLY_HMAC for `bun mock-gateway/server.ts`.
INGEST_HMAC_REPLY=dev-reply-hmac
INGEST_TOKEN_REPLY=dev-reply-token
